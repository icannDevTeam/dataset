{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "functions": {
    "pages/api/pickup/**/*.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "pages/api/face/upload.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "pages/api/cron/**/*.js": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/run-scheduled-reports",
      "schedule": "*/15 * * * *"
    }
  ]
}
