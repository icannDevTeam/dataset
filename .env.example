# ─── Binus School API ────────────────────────────────────────────
# Base64-encoded API key for the Binus School authentication endpoint
API_KEY=your_base64_api_key_here

# ─── Firebase Admin SDK ──────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=000000000000000000000
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ─── Environment ─────────────────────────────────────────────────
NODE_ENV=development

# ─── Pickup System (TV/Admin) ─────────────────────────────────────
# Tenant scope for all pickup collections
TENANT_ID=binus-simprug
TENANT_AWARE=true
LEGACY_PATHS=false

# TV feed shared token (legacy URL mode) + dashboard/session secrets
PICKUP_TV_TOKEN=replace_with_random_long_token
SESSION_SECRET=replace_with_random_long_secret
CONSENT_SIGNING_SECRET=replace_with_random_long_secret

# Admin login bootstrap (if used by your environment)
SUPER_ADMIN_EMAIL=admin@binus-school.net
SUPER_ADMIN_PASSWORD=replace_with_strong_password

# Optional fallback secret used by some admin APIs/middleware
DASHBOARD_API_KEY=replace_with_random_long_secret

# Optional Hikvision integration values for device operations
HIKVISION_IP=
HIKVISION_USER=
HIKVISION_PASS=

# ─── Pickup System Demo Auto-Seed (Vercel API side) ───────────────
# Enables automatic seeding when targeted TV profile is claimed.
PICKUP_DEMO_AUTO_SEED=true
# Target profile for auto-seeding (example: PYP 35 profile id)
PICKUP_DEMO_PROFILE_ID=pyp-lobby-grades-3-5
# Optional fallback name match (used when id is different per environment)
PICKUP_DEMO_PROFILE_NAME=
# Teacher account to bias seeded data toward (for class scopes)
PICKUP_DEMO_TEACHER_EMAIL=albert@binus.edu
# Optional fallback class scopes when teacher doc has none
PICKUP_DEMO_CLASS_SCOPES=4C
# Number of seeded events per run (5..80)
PICKUP_DEMO_EVENT_COUNT=35
